{
  "id": "/",
  "name": "MyTracker",
  "short_name": "MyTracker",
  "description": "Привычки, задачи, цели и календарь в одном месте",
  "lang": "ru",
  "start_url": "/today",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b1117",
  "theme_color": "#0b1117",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Задачи", "url": "/tasks", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Привычки", "url": "/habits", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Календарь", "url": "/calendar", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
