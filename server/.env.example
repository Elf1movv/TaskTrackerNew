DATABASE_URL="postgresql://USER@localhost:5432/tasktracker"
PORT=3001
# Any random string works locally — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"
# Leave empty to log emails to the console instead of sending them —
# see server/src/lib/email.ts.
RESEND_API_KEY=
RESEND_FROM_EMAIL="MyTracker <onboarding@resend.dev>"
# Leave empty to just log/store feedback submissions without emailing them —
# see server/src/routes/feedback.ts. Temporary beta-testing feature.
FEEDBACK_EMAIL_TO=
