generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id          String    @id @default(uuid())
  title       String
  completed   Boolean   @default(false)
  priority    String
  category    String
  // @db.Date (not DateTime) — no time-of-day component, matches the
  // client's "YYYY-MM-DD" wire format exactly and avoids timezone drift
  // that a full timestamp would introduce.
  dueDate     DateTime? @db.Date
  // "HH:mm", 24h — same convention as Reminder.time: a user-facing label
  // with no instant/timezone attached, not a DB time type. Only
  // meaningful when dueDate is set; the client (TaskForm) is responsible
  // for not offering a time picker while the due-date toggle is off, the
  // server doesn't enforce that relationship.
  time        String?
  // "HH:mm", 24h — optional end of the task's timed block on the Day/Week
  // calendar timeline. Only meaningful when both dueDate and time are
  // set; nullable and never backfilled, same convention as time itself.
  endTime     String?
  // Set when `completed` flips to true, cleared when it flips back to
  // false. Deliberately separate from `updatedAt`, which changes on any
  // edit (e.g. renaming a task weeks later would otherwise make it look
  // like it was just completed today).
  completedAt DateTime?
  order       Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([order])
  @@index([dueDate])
  @@index([userId])
}

model Goal {
  id          String   @id @default(uuid())
  title       String
  description String
  progress    Int
  // null = no deadline ("бессрочная") — the target-date toggle in
  // GoalForm defaults new goals to off, matching Task.dueDate's pattern.
  targetDate  String?
  color       String
  // Kept as an embedded JSON array (matching the frontend's Milestone[]
  // shape exactly) rather than a separate related table — same
  // "start simple" choice already made for Task. Milestone order is just
  // its position in this array, no separate order column needed for it.
  milestones  Json
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([order])
  @@index([userId])
}

model Habit {
  id             String     @id @default(uuid())
  title          String
  icon           String
  color          String
  completedDates String[]
  // Days of week this habit is scheduled on — JS `Date.getDay()` values
  // (0=Sunday..6=Saturday). Defaults to every day, so existing habits keep
  // their current always-shown behavior until someone deliberately narrows
  // it via HabitForm.
  activeDays     Int[]      @default([0, 1, 2, 3, 4, 5, 6])
  order          Int
  // Independent from `order` above: `order` is this habit's position
  // within its group on the /habits page, `todayOrder` is its position
  // within the same group's card on the Today page — dragging on one
  // screen must not move the habit on the other (see PROJECT_BRAIN.md /
  // the habit-groups feature docs for why one screen isn't enough).
  todayOrder     Int
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Every habit belongs to a group — including the auto-seeded "General"
  // one (HabitGroup.isGeneral) for habits that aren't in a named block.
  // A real FK, unlike Task.category's plain-string approach — see the
  // comment on HabitGroup for why that indirection wasn't chosen here.
  groupId        String
  group          HabitGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@index([order])
  @@index([todayOrder])
  @@index([userId])
  @@index([groupId])
}

// Named, collapsible blocks a user can sort their habits into (e.g.
// "Morning" 🌅), one level only, mirroring how Goals expand as accordion
// items. Deliberately a real FK from Habit (unlike Category, which stays a
// plain string on Task) — a block needs to be safely renameable/
// draggable without any risk of a name-matching desync.
model HabitGroup {
  id        String   @id @default(uuid())
  title     String
  icon      String
  // Only used by the Today page's card header (a colored pill behind the
  // block's name) — the /habits page's accordion header doesn't use it.
  color     String
  // The one auto-seeded, undeletable "General" bucket every user gets (see
  // User.habitGroupsSeeded) — habits land here by default and whenever
  // their real group gets deleted. Renaming/re-icon/re-coloring it is
  // allowed like any other group; only deleting it is blocked, since its
  // habits would have nowhere left to go. Its title/icon/color on this row
  // are just placeholders until the user first edits them — the client
  // substitutes its own localized label/icon while they still match the
  // placeholder, since the server has no concept of the user's language
  // (see habitGroupDisplay.ts).
  isGeneral Boolean  @default(false)
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits    Habit[]

  @@index([order])
  @@index([userId])
}

// A plain list of category names the user has defined — deliberately NOT a
// foreign key from Task.category (which stays a plain string, as before) to
// avoid a migration touching real Task data. This is just "what options does
// the category picker offer", the same "start simple" choice as Goal.milestones.
model Category {
  id        String   @id @default(uuid())
  name      String
  // Drives the pastel fill of that category's task blocks on the calendar
  // (Day/Week/Month) — see resolveCategoryColor.ts on the client.
  color     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Per-user uniqueness, not global — otherwise only the first user could
  // ever have a category named "Work".
  @@unique([userId, name])
  @@index([order])
}

// Standalone lightweight entity — deliberately separate from Task/Goal.
// Unlike them, has no manual `order` column: reminders are always sorted
// by date+time, never drag-reordered.
model Reminder {
  id        String   @id @default(uuid())
  title     String
  // @db.Date, same reasoning as Task.dueDate — no time-of-day component on
  // this column, that's `time` below.
  date      DateTime @db.Date
  // "HH:mm", 24h — plain string, not a DB time type: it's a user-facing
  // label with no instant/timezone attached, unlike a real timestamp.
  // null = reminder isn't pinned to a specific time, just a day.
  time      String?
  // "normal" | "critical" — plain string like Task.priority, validated at
  // the zod layer, not a Postgres enum. Critical ones trigger the
  // center-screen alert popup; normal ones don't.
  priority  String   @default("normal")
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// A temporary beta-testing feature (see LEARNING.md) — free-text feedback
// plus an optional screenshot, stored here so nothing is lost even before
// a real recipient inbox exists, and mirrored to email when one is set.
model Feedback {
  id        String   @id @default(uuid())
  message   String
  // Base64 data URL of an optionally-attached screenshot — kept as a plain
  // column, not a separate file-storage table, since this is a low-volume,
  // temporary feature (see LEARNING.md for the "delete after beta" plan).
  imageData String?
  page      String?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Better Auth's required core schema (user/session/account/verification) —
// written by hand rather than via `npx auth generate`, which has a known
// history of overwriting hand-maintained models in schema.prisma (see
// LEARNING.md). Field shapes and @@map names must match exactly what
// Better Auth's Prisma adapter expects.
model User {
  id                String       @id
  name              String
  email             String
  emailVerified     Boolean
  image             String?
  createdAt         DateTime
  updatedAt         DateTime
  // Distinguishes "never seeded" from "seeded, then deleted every
  // category" — a bare count of the user's categories can't tell those
  // apart, which used to let deleting your last category silently
  // resurrect the 4 defaults on next load. See LEARNING.md.
  categoriesSeeded  Boolean      @default(false)
  // Same "never seeded" vs "seeded, then user deleted everything" distinction
  // as categoriesSeeded above — guards the one auto-created "General"
  // HabitGroup the same way, see routes/habitGroups.ts.
  habitGroupsSeeded Boolean      @default(false)
  sessions          Session[]
  accounts          Account[]
  tasks             Task[]
  goals             Goal[]
  habits            Habit[]
  habitGroups       HabitGroup[]
  categories        Category[]
  reminders         Reminder[]
  feedbacks         Feedback[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

// One row per login method — the hashed password for email/password auth
// lives here (providerId "credential"), not on User.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

// Short-lived tokens: email verification links, password reset links.
model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
